{
  "name": "vitamix-embeddings",
  "version": "2.0.0",
  "description": "Vitamix Recipe Embeddings Cloud Function - Firebase Vector Search",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npx @google-cloud/functions-framework --target=$GOOGLE_FUNCTION_TARGET --source=lib/index.js",
    "deploy": "npm run build && firebase deploy --only functions",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.10.0",
    "@google-cloud/functions-framework": "^3.4.0",
    "@google-cloud/storage": "^7.14.0",
    "google-auth-library": "^9.14.0",
    "firebase-admin": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "20"
  }
}
